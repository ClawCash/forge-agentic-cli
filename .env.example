# Copy to .env and fill in. Never commit .env.
#
# The /v1 reviews API only needs DATABASE_URL and the Resend settings below.
# Everything else is for the hackathon demo, which starts only when
# SERVICE_OWNER_* is set. That demo runs on Hedera testnet, so use testnet keys
# only. Each key is an ECDSA key: send testnet HBAR
# to its EVM address (https://portal.hedera.com/faucet) to create its Hedera
# account, then get testnet USDC at https://faucet.circle.com (Hedera Testnet).
# `npm run hedera:status` shows each wallet's account and balances.

# Owns the two demo services' ERC-8004 identities, receives their payments, and
# signs the merchant's replies to reviews (appendResponse), so readers can check
# them against ownerOf(agentId). Must differ from the reviewers.
SERVICE_OWNER_PRIVATE_KEY=
# Paying and reviewing agents.
AGENT_A_PRIVATE_KEY=
AGENT_B_PRIVATE_KEY=
# Wallet `reviews pay` uses when --agent is not given (a or b).
REVIEWS_AGENT=

# Demo seller APIs and reviews API.
PORT=8787
# ERC-8004 agent IDs of the two demo services on Hedera testnet, set by
# `npm run services:register -- --save`.
DEMO_API_A_AGENT_ID=
DEMO_API_B_AGENT_ID=

# Reviewers whose onchain reviews `reviews check` counts (comma-separated 0x
# addresses). Empty means anyone. For the demo: agent A's and agent B's addresses.
TRUSTED_REVIEWERS=

# Postgres for the reviews API (on Railway: ${{Postgres.DATABASE_URL}}). Without
# it the server keeps reviews in memory.
# DATABASE_URL=

# World ID Agent Pass (auth.world.org/portal): a person approves counted reviews
# and payments above the spending cap. Callback URL:
# https://reviews-api.forgeintel.co/approvals/callback
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Demo only: "true" lets a person approve more than one review per service and
# task. Extra ones are marked as repeats in their review document.
# ALLOW_REPEAT_HUMAN_REVIEWS=

# The free /v1 reviews API. Sends reviewers their signup code; without these,
# reading works but nobody can sign up to review.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Signs short-lived challenges and codes. Set it when running several replicas.
# REVIEWS_SECRET=

# Optional overrides.
# BASE_RPC_URL=https://base-rpc.publicnode.com
# TEMPO_RPC_URL=https://rpc.tempo.xyz
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PUBLIC_BASE_URL=https://<your-domain>   # server's public origin (Railway: from RAILWAY_PUBLIC_DOMAIN)
# REVIEWS_HOME=~/.config/forge-agentic-cli   # where the CLI keeps paid interactions
# WORLD_ISSUER=https://auth.world.org
# REVIEWS_SERVER=https://reviews-api.forgeintel.co
# SERVICE_OWNER_HEDERA_ACCOUNT_ID=   # otherwise looked up from the owner's key
# HEDERA_RPC_URL=https://testnet.hashio.io/api
# X402_FACILITATOR_URL=https://x402.org/facilitator
