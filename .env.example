# Copy to .env and fill in. Testnet keys only; never commit .env.

# Arc testnet (chain 5042002). Fund wallets at https://faucet.circle.com (Arc Testnet).
ARC_RPC_URL=https://rpc.testnet.arc.io

# Owns the two demo services' ERC-8004 identities and signs the merchant's
# replies to reviews (appendResponse), so readers can check them against
# ownerOf(agentId). Must differ from the reviewers.
SERVICE_OWNER_PRIVATE_KEY=
# Paying and reviewing agents.
AGENT_A_PRIVATE_KEY=
AGENT_B_PRIVATE_KEY=

# Demo seller APIs and reviews API.
PORT=8787
# ERC-8004 agent IDs of the two demo services, set after registering them (Phase 3).
DEMO_API_A_AGENT_ID=
DEMO_API_B_AGENT_ID=
