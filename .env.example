# Copy to .env and fill in. Testnet keys only; never commit .env.

# Arc testnet (chain 5042002). Fund wallets at https://faucet.circle.com (Arc Testnet).
ARC_RPC_URL=https://rpc.testnet.arc.io

# Owns the two demo services' ERC-8004 identities. Must differ from the reviewers.
SERVICE_OWNER_PRIVATE_KEY=
# Paying and reviewing agents.
AGENT_A_PRIVATE_KEY=
AGENT_B_PRIVATE_KEY=
# Signs the merchant's replies to reviews (appendResponse).
MERCHANT_REPLY_PRIVATE_KEY=

# Demo seller APIs and reviews API.
PORT=8787
