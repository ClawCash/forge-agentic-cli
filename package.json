{
  "name": "forge-agentic-cli-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "cli",
    "server",
    "app"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/src/index.ts",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types --watch server/src/index.ts",
    "start:server": "node --env-file-if-exists=.env --experimental-strip-types server/src/index.ts",
    "reviews": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types cli/src/index.ts",
    "wallet:new": "node --experimental-strip-types scripts/new-wallet.ts",
    "hedera:status": "node --env-file-if-exists=.env --experimental-strip-types scripts/hedera-status.ts",
    "services:register": "node --env-file-if-exists=.env --experimental-strip-types scripts/register-services.ts",
    "services:verify": "node --env-file-if-exists=.env --experimental-strip-types scripts/verify-services.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "dev:app": "npm run dev -w app",
    "build:app": "npm run build -w app",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/demo/agent.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "drizzle-kit": "^0.31.11",
    "mppx": "0.17.6",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "dependencies": {
    "@x402/hedera": "2.30.0",
    "viem": "2.57.17"
  }
}
