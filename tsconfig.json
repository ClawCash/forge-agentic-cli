{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "cli/src/**/*.ts",
    "server/src/**/*.ts",
    "shared/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
